[Unit]
Description=Aquatum Lead Proxy (Brevo)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/aquatum-landingpage/server
EnvironmentFile=/etc/aquatum-leadproxy.env
ExecStart=/usr/bin/python3 /opt/aquatum-landingpage/server/leadproxy.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
# Legt /var/lib/aquatum-leadproxy an (Eigentuemer = www-data) fuer die Lead-Datei.
# Passend zu LEADS_FILE=/var/lib/aquatum-leadproxy/leads.jsonl in der .env.
StateDirectory=aquatum-leadproxy
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
