# Kopie als /etc/aquatum-leadproxy.env anlegen (AUSSERHALB des Web-Roots!),
# chown root:root, chmod 600 — NIE im Web-Root /opt/aquatum-landingpage, sonst
# waere die Datei via https://.../.env oeffentlich abrufbar.
BREVO_API_KEY=xkeysib-DEIN_KEY
BREVO_LIST_ID=5
# Absender der E-Mails. Adresse MUSS in Brevo als Absender verifiziert sein,
# sonst werden keine Mails verschickt (bestehende verifizierte Adresse weiter nutzen).
BREVO_SENDER_EMAIL=info@regenfaenger.ch
BREVO_SENDER_NAME=Regenfänger
# Interne Lead-Benachrichtigung: jeder Lead geht zusaetzlich an diese Adresse
# (replyTo = E-Mail des Leads). Leer lassen = keine Benachrichtigung.
LEAD_NOTIFY_EMAIL=irma@leadhunter.ch
LEADPROXY_HOST=127.0.0.1
LEADPROXY_PORT=3010

# --- Lead-Backend (Admin-Ansicht unter /admin.html) ---
# Jeder Lead wird zusaetzlich als JSON-Zeile in dieser Datei gespeichert.
# MUSS ausserhalb des Web-Roots liegen (sonst oeffentlich abrufbar!).
# Wird vom systemd-StateDirectory automatisch mit Eigentuemer www-data angelegt.
LEADS_FILE=/var/lib/aquatum-leadproxy/leads.jsonl
# Passwort fuer den Login auf /admin.html. LANG und ZUFAELLIG waehlen!
# z.B. erzeugen mit:  openssl rand -base64 24
# Leer lassen = /api/leads ist komplett deaktiviert.
ADMIN_TOKEN=BITTE_LANGES_ZUFALLS_PASSWORT_SETZEN
