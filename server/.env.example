# Kopie als /etc/aquatum-leadproxy.env anlegen (AUSSERHALB des Web-Roots!),
# chown root:root, chmod 600 — NIE im Web-Root /opt/aquatum-landingpage, sonst
# waere die Datei via https://.../.env oeffentlich abrufbar.
BREVO_API_KEY=xkeysib-DEIN_KEY
BREVO_LIST_ID=5
BREVO_SENDER_EMAIL=info@wasserfilter-beratung.ch
BREVO_SENDER_NAME=Aquatum Wasserfilter-Beratung
LEADPROXY_HOST=127.0.0.1
LEADPROXY_PORT=3010
